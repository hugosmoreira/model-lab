# Model Lab — environment (copy to `.env` at the repo root, or to
# apps/web/.env.local). Shell values win, then Next's mode-specific app files,
# then root .env fallback. Web and CLI share this loader; test mode skips the
# app .env.local just as Next does. Root .env uses Node dotenv syntax.
#
# Every variable is SERVER-SIDE ONLY — none is NEXT_PUBLIC_, none ever reaches
# the browser. The memory store seeds illustrative demo data. Cloud endpoints
# whose required key is absent run as mocks; keyless Ollama runs locally.

# ---------------------------------------------------------------------------
# Persistence store (@model-lab/store)
# ---------------------------------------------------------------------------
# memory (default) | sqlite | supabase
#   memory   — in-process Maps; auto-seeds the demo run (run_8f3ac21e).
#   sqlite   — Node's built-in node:sqlite; persists across restarts.
#   supabase — hosted Postgres; requires the two SUPABASE_ vars below.
MODEL_LAB_STORE=memory

# sqlite only: database file path (default <repo>/artifacts-data/model-lab.db)
#MODEL_LAB_SQLITE_PATH=

# supabase only: project URL + service-role key (server-only secret; never
# expose it to a browser). See docs/SUPABASE_SETUP.md.
#SUPABASE_URL=
#SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Build Arena runner (@model-lab/build-arena-runner)
# ---------------------------------------------------------------------------
# Root for run artifacts, raw output, screenshots, events and bundles
# (default <repo>/artifacts-data — gitignored)
#MODEL_LAB_DATA_DIR=

# Mock provider substitution:
#   1     — force ALL selected endpoints AND the judge to the deterministic
#           mock provider (never spends money, never touches a network).
#   0     — never substitute (force real providers, e.g. local Ollama only).
#   unset — auto: mock cloud endpoints whose required API key is absent;
#           keyless Ollama endpoints run against OLLAMA_BASE_URL.
#MODEL_LAB_MOCK_PROVIDERS=1

# Read-only instance: every page and GET keeps working, but POST /api/runs,
# votes and annotations answer 403. Pair with MODEL_LAB_MOCK_PROVIDERS=1 and no
# keys for a public demo (the API has no authentication of its own).
#MODEL_LAB_READ_ONLY=1

# Exact browser origin for writable non-loopback/proxy deployments, e.g.
# https://models.example.com (no path). Local localhost/127.0.0.1/[::1] origins
# work without this setting. Forwarded headers never authorize writes.
# HTTP clients must send this exact Origin and Content-Type: application/json;
# the CLI calls the run service directly. This does not replace authentication.
#MODEL_LAB_APP_ORIGIN=

# What local models run on, recorded into every run's provenance (the
# registry already records each local model's quantization). Free text.
#MODEL_LAB_LOCAL_HARDWARE=RTX 4090 · 24 GB

# Build provenance when .git is absent (e.g. container image): full source
# revision and whether that source checkout had uncommitted changes.
#MODEL_LAB_SOURCE_REVISION=
#MODEL_LAB_SOURCE_DIRTY=0

# Managed, SHA-pinned Chrome Headless Shell: install with pnpm browser:install.
# Optional absolute cache directory; otherwise the user cache is used.
# An absolute PLAYWRIGHT_BROWSERS_PATH is a fallback cache override (not "0").
#MODEL_LAB_BROWSER_CACHE=
# Optional absolute executable override for trusted operators; the runner still
# rejects versions older than the checked-in security minimum. Other platforms
# and browser upgrades need the network-boundary regressions before certification.
#MODEL_LAB_BROWSER_EXECUTABLE=

# Output cap for real runs, in tokens (default 32000). Reasoning models spend
# their hidden thinking inside this budget; a sample that hits the cap is
# reported as truncated by the harness, never as a bad model.
#MODEL_LAB_MAX_OUTPUT_TOKENS=32000

# ---------------------------------------------------------------------------
# LLM judge (build-arena runs only; needs ANTHROPIC_API_KEY)
# ---------------------------------------------------------------------------
# 0 disables the rubric + order-swapped pairwise judge phase entirely.
#MODEL_LAB_JUDGE=1
# Judge model (default claude-sonnet-4-6). Judge spend counts against the
# run's budget ceiling.
#MODEL_LAB_JUDGE_MODEL=claude-sonnet-4-6

# ---------------------------------------------------------------------------
# Provider credentials (read by the runner only, server-side)
# ---------------------------------------------------------------------------
#ANTHROPIC_API_KEY=
#OPENAI_API_KEY=
#OPENROUTER_API_KEY=
# Google endpoints call the OpenAI-compatible surface with this key:
#GOOGLE_API_KEY=
# DeepSeek endpoints call api.deepseek.com's OpenAI-compatible surface:
#DEEPSEEK_API_KEY=

# Local Ollama server (default http://localhost:11434/v1); no key required.
#OLLAMA_BASE_URL=
