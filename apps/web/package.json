{
  "name": "@model-lab/web",
  "version": "0.2.0-rc.2",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm -w exec eslint apps/web",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test test/*.test.mjs && pnpm run test:frontend && pnpm run test:preview",
    "test:frontend": "pnpm -w exec tsx --tsconfig apps/web/tsconfig.json --test apps/web/scripts/frontend-truth.test.ts apps/web/scripts/mutation-limits.test.ts",
    "test:preview": "pnpm -w exec tsx --tsconfig apps/web/test/tsconfig.json --test apps/web/test/artifact-preview.test.tsx"
  },
  "dependencies": {
    "@model-lab/build-arena-runner": "workspace:*",
    "@model-lab/schemas": "workspace:*",
    "@model-lab/store": "workspace:*",
    "fflate": "^0.8.2",
    "html-to-image": "^1.11.13",
    "next": "^15.5.25",
    "playwright": "1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.1.0"
  }
}
