# Model Lab — apps/web environment (copy to .env.local; all vars are
# SERVER-SIDE ONLY — none is NEXT_PUBLIC_, none ever reaches the client).
#
# The web app reads no provider credential itself: lib/server/run-service
# passes process.env through to the native Build Arena runner server-side.
# With no keys set, runs transparently use the deterministic mock providers.

# ---------------------------------------------------------------------------
# Persistence store (@model-lab/store)
# ---------------------------------------------------------------------------
# memory (default) | sqlite | supabase
#   memory   — in-process Maps; auto-seeds the demo run (run_8f3ac21e).
#   sqlite   — Node 22 built-in node:sqlite; persists across restarts.
#   supabase — hosted Postgres; requires the two SUPABASE_ vars below.
MODEL_LAB_STORE=memory

# sqlite only: database file path (default <repo>/artifacts-data/model-lab.db)
#MODEL_LAB_SQLITE_PATH=

# supabase only: project URL + service-role key (server-only secret; never
# expose it to a browser). See docs/SUPABASE_SETUP.md.
#SUPABASE_URL=
#SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Build Arena runner (@model-lab/build-arena-runner)
# ---------------------------------------------------------------------------
# Root for run artifacts/raw output/screenshots/events
# (default <repo>/artifacts-data)
#MODEL_LAB_DATA_DIR=

# Mock provider substitution:
#   1     — force ALL selected endpoints to the deterministic mock provider
#           (never spends money, never touches a network).
#   0     — never substitute (force real providers, e.g. local Ollama only).
#   unset — auto: mock the whole run when no selected endpoint has its
#           required API key present in the environment.
#MODEL_LAB_MOCK_PROVIDERS=1

# ---------------------------------------------------------------------------
# Provider credentials (read by the runner only, server-side)
# ---------------------------------------------------------------------------
#ANTHROPIC_API_KEY=
#OPENAI_API_KEY=
#OPENROUTER_API_KEY=
# Google endpoints call the OpenAI-compatible surface with this key:
#GOOGLE_API_KEY=

# Local Ollama server (default http://localhost:11434/v1); no key required.
#OLLAMA_BASE_URL=
