{
  "name": "@model-lab/build-arena-runner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "lint": "pnpm -w exec eslint runners/build-arena",
    "test:checks": "node --experimental-strip-types --disable-warning=ExperimentalWarning test/check-taxonomy.test.mjs",
    "selftest": "tsx src/selftest.ts",
    "test": "pnpm run test:unit && pnpm run test:checks && pnpm run test:budget && pnpm run selftest",
    "test:unit": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test test/unit.test.mjs",
    "test:budget": "node --experimental-strip-types --disable-warning=ExperimentalWarning test/budget.test.mjs"
  },
  "dependencies": {
    "@model-lab/schemas": "workspace:*",
    "playwright": "^1.56.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "tsx": "^4.23.13"
  }
}
